# ============================================================
# LinkPulse — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
# ============================================================

# ------------------------------------------------------------
# Database (PostgreSQL via Neon or any PostgreSQL provider)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require&connect_timeout=30
# ------------------------------------------------------------
DATABASE_URL=

# ------------------------------------------------------------
# Auth.js / NextAuth
# NEXTAUTH_SECRET / AUTH_SECRET: Run `openssl rand -base64 32` to generate.
# NEXTAUTH_URL: The full URL of your app (no trailing slash).
#   Development: http://localhost:3000
#   Production:  https://your-app.vercel.app
# ------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
AUTH_SECRET=

# ------------------------------------------------------------
# Upstash Redis (Rate Limiting)
# Create a free database at https://console.upstash.com/
# Use the REST API credentials (not the Redis connection string).
# ------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------
# App Configuration (public — safe to expose to the browser)
# NEXT_PUBLIC_APP_URL: Same as NEXTAUTH_URL (used in client code).
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LinkPulse
