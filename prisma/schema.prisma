generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  links Link[]
}

model Link {
  id          String    @id @default(cuid())
  shortCode   String    @unique
  originalUrl String
  userId      String
  title       String?
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  clicks Click[]

  @@index([shortCode])
  @@index([userId])
  @@index([expiresAt])
}

model Click {
  id         String   @id @default(cuid())
  linkId     String
  timestamp  DateTime @default(now())
  referrer   String?
  deviceType String?
  browser    String?
  ipHash     String?
  country    String?

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@index([linkId, timestamp])
  @@index([timestamp])
}
